DATABASE_URL=postgresql+asyncpg://maedeup:maedeup@localhost:5432/maedeup
REDIS_URL=redis://localhost:6379/0
APP_ENV=development

GOOGLE_CLIENT_ID=발급받은클라이언트ID
GOOGLE_CLIENT_SECRET=발급받은보안비밀
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
JWT_SECRET=랜덤문자열_여기를_변경하세요
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=발급받은Gemini키
KAKAO_REST_API_KEY=발급받은카카오REST키

# 시연 중 Google Calendar 자동 등록 끄기 (default true). 시연 시 false 권장.
AUTO_CALENDAR_PUSH=false

# 시연 시 Q5 hybrid 토글 ("내 선호" vs 그룹 다수결) UI dormant 시키려면 false.
# false 면 compute_preference_toggle_enabled() 가 항상 false → 추천 카드의
# 토글 UI 안 렌더 + ACT 5.5 시연 항목 graceful skip.
# Default: true (운영 환경).
PREFERENCE_TOGGLE_ENABLED=true
